GOOGLE_CLOUD_LOCATION=us-central1
GITHUB_3LO_AUTH_PROVIDER_ID=github-3lo

AGENT_BACKEND_URL=http://localhost:8000

# Where Auth Manager redirects the user after consent.
CONTINUE_URI=http://localhost:8080/commit

